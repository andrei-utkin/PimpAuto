---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import plate from '../../assets/plates/hero-mechanical-plate.png';
import car from '../../assets/plates/classic-car-detail.png';
import { interfaceCopy } from '../data/interface';
interface Copy {
  lang: string; path: string; title: string; description: string;
  headline: string; support: string; eyebrow: string;
  expertiseTitle: string; expertiseCopy: string; regionsTitle: string; regionsCopy: string;
  storesTitle: string; locationTitle: string; hoursTitle: string; hoursValue: string;
  phonesTitle: string; addressTitle: string; addressValue: string; contact: string;
}
const { copy } = Astro.props as { copy: Copy };
const ui = interfaceCopy[copy.lang as keyof typeof interfaceCopy] || interfaceCopy.en;
const languages = [
  { code: 'RU', href: '/', lang: 'ru', name: 'Русский' }, { code: 'EN', href: '/en/', lang: 'en', name: 'English' },
  { code: 'FR', href: '/fr/', lang: 'fr', name: 'Français' }, { code: 'PL', href: '/pl/', lang: 'pl', name: 'Polski' },
  { code: 'ES', href: '/es/', lang: 'es', name: 'Español' },
];
const stores = [
  { code: 'ES', country: ui.countries[0], href: 'https://avtopro.es/seller/pimpavto-1444481/' },
  { code: 'PL', country: ui.countries[1], href: 'https://avtopro.pl/seller/pimpavto-1394944/' },
];
const instagram = 'https://www.instagram.com/pimp_auto/';
---
<BaseLayout title={copy.title} description={copy.description} lang={copy.lang} localePath={copy.path}>
  <svg class="icon-definitions" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><defs>
    <symbol id="arrow" viewBox="0 0 24 24"><path d="M4 12h16m-6-6 6 6-6 6" /></symbol>
    <symbol id="external" viewBox="0 0 24 24"><path d="M6 18 18 6M6 6h12v12" /></symbol>
    <symbol id="phone" viewBox="0 0 24 24"><path d="m8 3 3 5-3 3a14 14 0 0 0 5 5l3-3 5 3-1 4c-8 2-18-8-16-16Z" /></symbol>
    <symbol id="pin" viewBox="0 0 24 24"><path d="M19 10c0 5-7 11-7 11S5 15 5 10a7 7 0 1 1 14 0Z"/><circle cx="12" cy="10" r="2.5"/></symbol>
  </defs></svg>
  <a class="skip-link" href="#main">{ui.skip}</a>
  <header class="header"><div class="header-inner wrap">
    <a class="brand" href={copy.path} aria-label="Pimp Auto"><svg viewBox="0 0 32 32" aria-hidden="true"><path d="M3 5h24l-5 7H3zm0 11h18l-5 7H3zm0 11h10l-3 4H3z" fill="currentColor"/></svg><span>PIMP AUTO<small>{ui.since}</small></span></a>
    <nav class="main-navigation" aria-label={ui.service}><a href="#service">{ui.service}</a><a href="#stores">{ui.stores}</a><a href="#mandelieu">{ui.contacts}</a></nav>
    <nav class="languages" aria-label={ui.language}>{languages.map(item => <a href={item.href} hreflang={item.lang} lang={item.lang} aria-label={item.name} aria-current={item.lang === copy.lang ? 'page' : undefined}>{item.code}</a>)}</nav>
  </div></header>
  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy"><h1 id="hero-title">{copy.headline}</h1><p class="hero-support">{copy.support}</p><div class="hero-actions"><a class="button button-primary" href="#request"><span>{ui.request}</span><svg class="icon" aria-hidden="true"><use href="#arrow" /></svg></a><a class="hero-call" href="tel:+48794551812"><svg class="icon" aria-hidden="true"><use href="#phone" /></svg>{ui.call}</a></div><p class="hero-specialties">{copy.eyebrow}</p></div>
      <figure class="hero-art"><Image src={plate} alt={ui.heroAlt} widths={[480, 800, 1200, 1470]} sizes="(max-width: 1023px) 100vw, 50vw" format="webp" loading="eager" fetchpriority="high" /><figcaption><span>PIMP AUTO</span><span>{ui.since}</span></figcaption></figure>
    </section>
    <section class="process-section wrap section" id="service" aria-labelledby="process-title"><div class="section-heading"><h2 id="process-title">{ui.process}</h2><p>{copy.contact}</p></div><ol class="steps">{ui.steps.map(([title, text], index) => <li><span class="step-number">0{index + 1}</span><h3>{title}</h3><p>{text}</p></li>)}</ol></section>
    <section class="expertise" aria-labelledby="expertise-title"><div class="wrap expertise-inner"><div class="expertise-copy"><h2 id="expertise-title">{copy.expertiseTitle}</h2><p>{copy.expertiseCopy}</p><a class="text-link" href="#request"><span>{ui.request}</span><svg class="icon" aria-hidden="true"><use href="#arrow" /></svg></a></div><Image class="car-photo" src={car} alt={ui.carAlt} widths={[480, 800, 1200]} sizes="(max-width: 1023px) 100vw, 50vw" format="webp" loading="lazy" /></div></section>
    <section class="sourcing wrap section" aria-labelledby="sourcing-title"><div><h2 id="sourcing-title">{copy.regionsTitle}</h2><p>{copy.regionsCopy}</p></div><ul class="markets">{ui.markets.map((name, index) => <li><span>{['EU', 'US', 'JP', '+'][index]}</span>{name}</li>)}</ul></section>
    <section class="stores-section" id="stores" aria-labelledby="stores-title"><div class="wrap section stores-inner"><div><h2 id="stores-title">{copy.storesTitle}</h2><p>{ui.storeIntro}</p></div><div class="store-list">{stores.map(store => <a class="store-entry" href={store.href} target="_blank" rel="noopener noreferrer"><span class="store-country">{store.code}</span><span class="store-name"><strong>{store.country}</strong><small>PimpAvto · AUTO.PRO</small></span><span class="store-action">{ui.open}</span><svg class="icon" aria-hidden="true"><use href="#external" /></svg></a>)}</div></div></section>
    <section class="request-section wrap section" id="request" aria-labelledby="request-title">
      <div class="request-intro"><h2 id="request-title">{ui.requestTitle}</h2><p>{ui.requestIntro}</p><a class="text-link" href={instagram} target="_blank" rel="noopener noreferrer"><span>{ui.direct}</span><svg class="icon" aria-hidden="true"><use href="#external" /></svg></a></div>
      <form class="request-form" id="parts-request-form" data-copied={ui.copied} data-failed={ui.failed}>
        <label><span>{ui.name} <small>({ui.optional})</small></span><input name="name" autocomplete="name" placeholder={ui.namePlaceholder} maxlength="120" /></label>
        <label><span>{ui.car}</span><input name="car" placeholder={ui.carPlaceholder} required maxlength="200" /></label>
        <label class="form-wide"><span>{ui.reference} <small>({ui.optional})</small></span><input name="reference" placeholder={ui.referencePlaceholder} maxlength="100" /></label>
        <label class="form-wide"><span>{ui.details}</span><textarea name="details" rows="3" placeholder={ui.detailsPlaceholder} required maxlength="2000"></textarea></label>
        <div class="form-wide form-actions"><button class="button button-blue" type="submit" disabled><span>{ui.submit}</span><svg class="icon" aria-hidden="true"><use href="#arrow" /></svg></button><p id="form-status" role="status" aria-live="polite">{ui.hint}</p></div>
        <noscript><a class="text-link" href={instagram} target="_blank" rel="noopener noreferrer">{ui.direct}</a></noscript>
        <div class="form-wide copy-result" id="copy-result" hidden><label id="manual-copy" hidden><span>{ui.draft}</span><textarea id="request-draft" readonly rows="6"></textarea></label><a class="text-link" href={instagram} target="_blank" rel="noopener noreferrer"><span>{ui.instagram}</span><svg class="icon" aria-hidden="true"><use href="#external" /></svg></a></div>
      </form>
    </section>
    <section class="contact-section" id="mandelieu" aria-labelledby="contact-title"><div class="wrap section contact-inner"><div class="contact-intro"><svg class="location-icon icon" aria-hidden="true"><use href="#pin" /></svg><h2 id="contact-title">{ui.visit}</h2><p>{ui.visitCopy}</p><a class="text-link" href="https://www.google.com/maps/search/?api=1&query=865%20av.%20de%20Cannes%2C%20Mandelieu-la-Napoule%2C%20France" target="_blank" rel="noopener noreferrer"><span>{ui.map}</span><svg class="icon" aria-hidden="true"><use href="#external" /></svg></a></div><dl class="contact-details"><div><dt>{copy.addressTitle}</dt><dd>865 av. de Cannes<br />Mandelieu-la-Napoule, France</dd></div><div><dt>{copy.hoursTitle}</dt><dd>{copy.hoursValue}</dd></div><div><dt>{copy.phonesTitle}</dt><dd><a href="tel:+48794551812">+48 794 551 812</a><a href="tel:+375447733339">+375 44 773 33 39</a></dd></div></dl></div></section>
  </main>
  <footer class="footer wrap"><a class="footer-brand" href={copy.path}>PIMP AUTO</a><p>{ui.footer}</p><small>© {new Date().getFullYear()} Pimp Auto</small><a href={instagram} target="_blank" rel="noopener noreferrer">Instagram<svg class="icon" aria-hidden="true"><use href="#external" /></svg></a></footer>
  <script>
    const form = document.querySelector<HTMLFormElement>('#parts-request-form');
    const submit = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (submit) submit.disabled = false;
    form?.addEventListener('submit', async event => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      const data = new FormData(form);
      const message = ['Pimp Auto', ...['name', 'car', 'reference', 'details'].map(name => {
        const input = form.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement;
        const label = input.labels?.[0]?.querySelector('span')?.childNodes[0]?.textContent?.trim() || name;
        const value = String(data.get(name) || '').trim();
        return value ? `${label}: ${value}` : '';
      }).filter(Boolean)].join('\n');
      const status = document.querySelector('#form-status');
      const result = document.querySelector<HTMLElement>('#copy-result');
      const manual = document.querySelector<HTMLElement>('#manual-copy');
      const draft = document.querySelector<HTMLTextAreaElement>('#request-draft');
      if (result) result.hidden = false;
      if (draft) draft.value = message;
      try {
        await navigator.clipboard.writeText(message);
        if (status) status.textContent = form.dataset.copied || '';
        if (manual) manual.hidden = true;
      } catch {
        if (status) status.textContent = form.dataset.failed || '';
        if (manual) manual.hidden = false;
        draft?.focus(); draft?.select();
      }
    });
    document.querySelectorAll<HTMLAnchorElement>('.languages a').forEach(link => {
      link.addEventListener('click', () => {
        const hash = window.location.hash;
        if (hash && document.getElementById(hash.slice(1))) link.hash = hash;
      });
    });
  </script>
</BaseLayout>
